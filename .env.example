TOMTOM_API_KEY=""

; Database connection (used by lgu_staff/includes/config.php).
; Leave these empty on localhost to fall back to the defaults (root, no
; password, db "qc_road_monitoring"); on the live server config.php falls
; back to lgu_staff/includes/config/live_db_config.php when no DB_* values
; are provided here. Set them to override either environment.
DB_HOST=""
DB_USER=""
DB_PASS=""
DB_NAME=""

; IPMS integration (road projects feed: new/ongoing/completed/cancelled) -
; coordinate real values with the IPMS teammate. ROAD_MONITORING_API_KEY
; must be the exact same string as ROAD_MONITORING_API_KEY in IPMS's own
; .env - never invent one, and never commit real values here (this file is
; tracked by git; only the real, gitignored .env should hold secrets).
; NOTE: comment lines in this file must use ";" not "#" - config.php loads
; this file with PHP's parse_ini_file(), which throws a syntax error on any
; "#" comment line containing parentheses (verified: even something as
; simple as "# see the docs (here)" breaks it). ";" comments are always
; safe with parse_ini_file() regardless of what they contain.
IPMS_BASE_URL=http://ipms.infragovservices.com
ROAD_MONITORING_API_KEY=b53d33ea4b17de66f7ac5bb22ec30ee2291a12414bc453fa09c3d167f03a82bf
IPMS_PULL_KEY=b9c390ff52d12d5a737706e4cc4d2e711d8d065557b69e10368f8c7bc3941ff8
